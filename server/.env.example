# Copy to server/.env. Nothing here is required for local development.
# Placeholders only. Never commit a real server/.env (it is gitignored).

PORT=5050
# NODE_ENV=production

# MongoDB. Leave unset to use the embedded local database (stored in server/.data and
# seeded automatically). Set it for production, e.g. a free MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ghumo
# Local Docker option: `docker compose up -d` from the repo root, then:
# MONGODB_URI=mongodb://localhost:27017/ghumo

# Seed demo data automatically when the database is empty. Defaults to on for the
# embedded DB. Set it to "true" to also seed an empty external database on first boot.
# SEED_ON_EMPTY=true

# Demo accounts. Locally they all share the password in README.md. In production the demo
# admin gets a random password unless DEMO_ADMIN_PASSWORD (or DEMO_PASSWORD) is set, because
# the admin can read every booking. Use long, private values on any public deployment.
# DEMO_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# Run the idempotent V0.1 data migration on boot (default on).
# AUTO_MIGRATE=true

# Embedded database (used only when MONGODB_URI is unset).
# EMBEDDED_DB_PATH=server/.data
# EMBEDDED_DB_PORT=
# MONGOMS_DOWNLOAD_DIR=server/.cache

# Required in production. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API (only needed when the client
# is hosted on a different origin from the API).
CLIENT_URL=http://localhost:5173

# AI Package Studio (server-side only, never exposed to the browser).
# Option A: Anthropic
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Option B: any OpenAI-compatible API (OpenAI, Gemini's OpenAI endpoint, Groq, etc.)
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# Option C: Google Gemini (uses its OpenAI-compatible endpoint, key from aistudio.google.com)
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-gemini-key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.5-flash,gemini-flash-latest,gemini-flash-lite-latest
# Optional model override. A comma-separated list is tried in order when a model is busy.
# AI_MODEL=
# Provider timeouts in milliseconds (defaults: 30000 general, discovery has its own).
# AI_TIMEOUT_MS=30000
# AI_DISCOVERY_TIMEOUT_MS=12000

# Where uploaded package photos are stored (default: server/uploads)
# UPLOAD_DIR=

# Optional abuse limits (defaults shown). RATE_LIMIT=off disables them (tests only).
# LOGIN_FAILURES_PER_15_MIN=10
# REGISTRATIONS_PER_15_MIN=20
# AI_RATE_LIMIT_PER_MIN=20
# AI_EXTRACTIONS_PER_HOUR=30
# GROUP_MESSAGES_PER_MIN=12

# Per-request logging. Each request writes one JSON line to stdout with a requestId
# echoed as the X-Request-Id response header, so a user's error report can be matched
# to the exact log entry. Lines contain only { time, level, requestId, method, path,
# status, durationMs, role } - never query strings, bodies, cookies, headers, IPs,
# emails, phones or user IDs. Static files (/assets/*, /uploads/*) log at debug level.
# Set to "false" to turn the lines off (tests and quiet output). Default: on.
# LOG_REQUESTS=false

# Client build only (client/.env): API origin when the web app is hosted separately.
# VITE_API_URL=
